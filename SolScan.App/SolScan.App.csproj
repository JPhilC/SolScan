<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <StartupObject>SolScan.App.App</StartupObject>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>AnyCPU;x64</Platforms>
    <ApplicationIcon>Assets\SolScan.ico</ApplicationIcon>
    <!-- The default Workstation GC is tuned for a mostly-idle UI app, not the camera capture
         thread's sustained high-throughput allocation (a fresh clone of each captured frame's
         buffer, often several MB - see AsiCameraDevice.CaptureLoop/AltairCameraDevice.OnNativeEvent
         - lands on the Large Object Heap every single frame at up to ~100fps). Server GC's
         per-core heaps are what .NET recommends for exactly this "sustained high-allocation-rate
         background workload" shape of problem; Concurrent GC (on by default, listed explicitly here
         so the pairing is deliberate, not incidental) keeps most Gen2/LOH collection work off to
         the side rather than blocking. Added to investigate a large observed fps gap
         (SharpCap/ASICap ~100fps vs SolScan ~19fps at the same Mono16 3840x500 ROI) - see CLAUDE.md
         for whether this closed the gap once validated against real hardware.
    -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <!-- The SDK's implicit default-items glob would otherwise also include these as <None>,
         alongside their explicit Resource entries below - two item types for the same file trips
         up WPF's resource generation ("An item with the same key has already been added",
         RG1000). Mirrors RASTA.App.csproj's equivalent Remove/Include pairing. -->
    <None Remove="Assets\ButtonBarFooter.png" />
    <None Remove="Assets\SolScan.ico" />
    <None Remove="Assets\SolScanSplash.png" />
    <Resource Include="Assets\ButtonBarFooter.png" />
    <Resource Include="Assets\SolScan.ico" />
    <!-- NOT the SplashScreen build action: that renders via a native GDI call before WPF's own
         rendering pipeline loads, and that path ignores PNG alpha entirely - transparent pixels
         always paint white. SplashWindow.xaml, a real AllowsTransparency WPF window shown
         manually from App.OnStartup, is what actually honors this image's transparency - see
         RASTA.App.csproj for the same note against the equivalent asset. -->
    <Resource Include="Assets\SolScanSplash.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SolScan.Core\SolScan.Core.csproj" />
    <ProjectReference Include="..\SolScan.Infrastructure\SolScan.Infrastructure.csproj" />
    <ProjectReference Include="..\SolScan.Processing\SolScan.Processing.csproj" />
    <!-- SimulatedCameraProvider - guarantees the Capture view's camera picker always has at
         least one entry, even with zero ZWO/Altair hardware attached. -->
    <ProjectReference Include="..\SolScan.Simulators\SolScan.Simulators.csproj" />
  </ItemGroup>

</Project>
