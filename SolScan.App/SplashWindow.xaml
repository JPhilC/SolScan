<Window x:Class="SolScan.App.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        Width="360" Height="360">
    <!-- Stretch="Uniform" scales SolScanSplash.png down to fit this window rather than showing it
         at native size, and the window itself being transparent (AllowsTransparency + Background
         Transparent, requires WindowStyle="None") is what actually lets the image's transparent
         background show through instead of painting white - see the SplashScreen build-action
         note in SolScan.App.csproj for why the simpler built-in mechanism can't do this. Mirrors
         RASTA.App/SplashWindow.xaml. -->
    <Image Source="/Assets/SolScanSplash.png" Stretch="Uniform"/>
</Window>
