<Application x:Class="SolScan.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SolScan.App"
             ShutdownMode="OnMainWindowClose">
    <!-- No StartupUri: App.xaml.cs builds the DI container and resolves MainWindow itself,
         same single-composition-root pattern RASTA uses. ShutdownMode is explicit (rather than
         the default OnLastWindowClose) so WPF doesn't treat the SplashWindow shown first in
         OnStartup as the app's "last window" once it closes - Application.MainWindow is set
         explicitly to the real MainWindow in App.xaml.cs before that happens. -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- App-wide scrollbar look - see that file's own doc comment (it's also merged into
                     MaterialDesignScoped.xaml, which would otherwise shadow it in the views using that). -->
                <ResourceDictionary Source="/Themes/ScrollBarStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        <!-- Implicit style (no x:Key) so every Window - MainWindow, SplashWindow, and any added
             later - picks up the app icon without having to set it individually. Mirrors
             RASTA.App/App.xaml's equivalent style. -->
        <Style TargetType="Window">
            <Setter Property="Icon" Value="/Assets/SolScan.ico"/>
        </Style>
        <!-- Implicit style so every plain-string ToolTip="..." set anywhere in the app wraps at a
             readable width instead of rendering as one very long unwrapped line - WPF's own default
             ToolTip template doesn't wrap a plain string by default. {Binding} inside the
             ContentTemplate resolves to the ToolTip's own Content (the string), a standard WPF trick;
             it's simply not applied when a control's ToolTip is already a UIElement (e.g. a TextBlock
             set directly), so those remain unaffected. -->
        <Style TargetType="{x:Type ToolTip}">
            <Setter Property="MaxWidth" Value="340"/>
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
