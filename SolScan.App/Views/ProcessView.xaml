<UserControl x:Class="SolScan.App.Views.ProcessView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:processing="clr-namespace:SolScan.App.Views.Processing"
             mc:Ignorable="d">
    <UserControl.Resources>
        <!-- Scoped to this view only, not merged into App.xaml - see Themes/MaterialDesignScoped.xaml's
             own doc comment for why (and why it's a shared file now that CaptureView.xaml uses the same
             md:DrawerHost pattern too). -->
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/MaterialDesignScoped.xaml" />
                <!-- ToolbarIconButtonStyle - see that file's own doc comment; shared with
                     CaptureView.xaml/HandControlWindow.xaml. -->
                <ResourceDictionary Source="/Themes/IconButtonStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Margin="24">
        <!-- md:DrawerHost's right-hand drawer is a full-height overlay, not a permanent Grid column -
             it slides in on top of (not squeezing) the content below, so the preview/status area
             underneath always has the view's full width to itself. IsRightDrawerOpen and both hamburger
             ToggleButtons (one here to open, one inside RightDrawerContent to close) all bind to the
             same ProcessViewModel.IsProcessOptionsPanelExpanded bool, so however it's toggled, the
             state - and thus what gets persisted to AppSettings - stays in one place. Mirrors GSServer's
             own md:DrawerHost usage (e.g. SkyTelescopeV.xaml's VM-bound IsLeftDrawerOpen) with Left
             swapped for Right throughout, per the user's own request. -->
        <md:DrawerHost HorizontalAlignment="Stretch" VerticalAlignment="Stretch" BorderThickness="0"
                       IsRightDrawerOpen="{Binding IsProcessOptionsPanelExpanded, Mode=TwoWay}"
                       BorderBrush="{StaticResource MaterialDesignDivider}">
            <md:DrawerHost.RightDrawerContent>
                <Grid Width="340">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="12,12,12,0">
                        <ToggleButton DockPanel.Dock="Right"
                                      Style="{StaticResource MaterialDesignHamburgerToggleButton}"
                                      Command="{x:Static md:DrawerHost.CloseDrawerCommand}"
                                      CommandParameter="{x:Static Dock.Right}"
                                      IsChecked="{Binding IsProcessOptionsPanelExpanded, Mode=TwoWay}"
                                      ToolTip="Hide this panel"/>
                        <TextBlock Text="Process Options" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                    </DockPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                        <StackPanel Margin="12">
                            <Expander Header="Process Parameters" IsExpanded="{Binding IsProcessParametersExpanded, Mode=TwoWay}" Margin="0,0,0,12">
                                <processing:ProcessParametersView DataContext="{Binding ProcessParameters}"/>
                            </Expander>
                            <Expander Header="Image Enhancement" IsExpanded="{Binding IsImageEnhancementExpanded, Mode=TwoWay}" Margin="0,0,0,12">
                                <processing:ImageEnhancementView DataContext="{Binding ImageEnhancement}"/>
                            </Expander>
                            <Expander Header="Image Selection" IsExpanded="{Binding IsImageSelectionExpanded, Mode=TwoWay}" Margin="0,0,0,12">
                                <processing:ImageSelectionView DataContext="{Binding ImageSelection}"/>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </md:DrawerHost.RightDrawerContent>

            <!-- Main content - always full-width since the panel is an overlay drawer rather than a
                 permanent side column. Restructured to match CaptureView's shape: every control
                 (Browse/Process/Cancel/the processed-image picker) lives in one top toolbar row, with
                 the Settings hamburger pinned to the far right (a DockPanel, same reasoning as
                 CaptureView's own top toolbar - see that view's history for why a DockPanel is the
                 right tool once the two sides need different alignment); file/equipment info sits in
                 its own row underneath the buttons rather than interleaved between two separate button
                 rows the way it used to be; and the preview fills all remaining space (a Grid row
                 sized "*" - unlike the StackPanel this used to be, a Grid can actually stretch a row
                 to fill leftover space) instead of being capped to a fixed 640x640 box. Status
                 narration moved off this view entirely - see StatusBarViewModel.ProcessStatusText -
                 so it's visible from any stage, matching Capture/Mount's own status-bar fields. -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Top bar: Browse/Process/Cancel + the processed-image picker, left-aligned, with
                     the Settings hamburger pushed to the far right. -->
                <DockPanel Grid.Row="0">
                    <ToggleButton DockPanel.Dock="Right" VerticalAlignment="Center" Margin="8,0,0,0"
                                  Style="{StaticResource MaterialDesignHamburgerToggleButton}"
                                  Command="{x:Static md:DrawerHost.OpenDrawerCommand}"
                                  CommandParameter="{x:Static Dock.Right}"
                                  IsChecked="{Binding IsProcessOptionsPanelExpanded, Mode=TwoWay}"
                                  ToolTip="Show the Process Parameters/Image Enhancement/Image Selection panel"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource ToolbarIconButtonStyle}"
                                Command="{Binding BrowseForSerFileCommand}"
                                ToolTip="Browse for a .ser file to process.">
                            <Image Source="/Assets/Icons/BrowseForFile.png" Width="20" Height="20" Stretch="Uniform"/>
                        </Button>
                        <Button Style="{StaticResource ToolbarIconButtonStyle}"
                                Command="{Binding ProcessCommand}"
                                ToolTip="Run the SHG reconstruction pipeline on the selected file.">
                            <Image Source="/Assets/Icons/ProcessRun.png" Width="20" Height="20" Stretch="Uniform"/>
                        </Button>
                        <Button Style="{StaticResource ToolbarIconButtonStyle}"
                                Command="{Binding CancelProcessingCommand}"
                                Visibility="{Binding IsProcessing, Converter={StaticResource BooleanToVisibilityConverter}}"
                                ToolTip="Cancel the running processing job.">
                            <Image Source="/Assets/Icons/CancelProcessing.png" Width="20" Height="20" Stretch="Uniform"/>
                        </Button>

                        <!-- Empty (no items) until an output folder actually has .png files in it - a
                             bare ComboBox collapses to its minimal size, so this stays unobtrusive
                             rather than needing extra visibility plumbing for the "nothing yet" case.
                             Disk-based, not tied to the most recent Process click - see
                             ProcessViewModel's own class doc comment. -->
                        <TextBlock Text="View:" VerticalAlignment="Center" Margin="16,0,8,0" />
                        <ComboBox ItemsSource="{Binding AvailableProcessedImages}"
                                  SelectedItem="{Binding SelectedProcessedImage}"
                                  DisplayMemberPath="Label"
                                  Width="200" VerticalAlignment="Center" />
                    </StackPanel>
                </DockPanel>

                <!-- File/equipment info - one row beneath the toolbar. -->
                <StackPanel Grid.Row="2">
                    <TextBlock Text="{Binding SelectedFilePath}" />
                    <TextBlock Text="{Binding FileInfoText}"
                               Margin="0,4,0,0"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{Binding EquipmentInfoText}"
                               Margin="0,4,0,0" />
                    <TextBlock Text="{Binding CaptureDetailsText}"
                               Margin="0,4,0,0"
                               Opacity="0.8" />
                    <TextBlock Text="{Binding OutputFolderText}"
                               Margin="0,4,0,0"
                               Opacity="0.8" />
                </StackPanel>

                <!-- Auto-stretched (see ProcessViewModel.UpdateProcessedImagePreview) - the saved PNGs
                     are deliberately unstretched real sensor-scale values, which would look flat/washed
                     here without this. HighQuality scaling since the preview is downsampled then
                     magnified back up, same reasoning as CaptureView's own live-preview Image. Fills
                     all remaining space rather than a fixed MaxWidth/MaxHeight cap; wrapped in a
                     ScrollViewer, matching CaptureView's own preview container, for the rare case the
                     content doesn't fit the available area. -->
                <Border Grid.Row="4" BorderBrush="Gray" BorderThickness="1">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <Image Source="{Binding ProcessedImagePreview}"
                               Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                    </ScrollViewer>
                </Border>
            </Grid>
        </md:DrawerHost>
    </Grid>
</UserControl>
