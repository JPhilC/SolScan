<UserControl x:Class="SolScan.App.Views.ProcessView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:processing="clr-namespace:SolScan.App.Views.Processing"
             xmlns:views="clr-namespace:SolScan.App.Views"
             mc:Ignorable="d">
    <UserControl.Resources>
        <!-- Scoped to this view only, not merged into App.xaml - see Themes/MaterialDesignScoped.xaml's
             own doc comment for why (and why it's a shared file now that CaptureView.xaml uses the same
             md:DrawerHost pattern too). -->
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/MaterialDesignScoped.xaml" />
                <!-- ToolbarIconButtonStyle - see that file's own doc comment; shared with
                     CaptureView.xaml/HandControlWindow.xaml. -->
                <ResourceDictionary Source="/Themes/IconButtonStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <!-- Main content (the DrawerHost + everything in it, unchanged) always takes whatever
                 space isn't claimed by the two columns below. -->
            <ColumnDefinition Width="*"/>
            <!-- The resizing splitter's own column - collapses to 0 for free whenever the panel isn't
                 docked, since Width="Auto" sizes to its GridSplitter's Visibility (bound to
                 IsProcessOptionsPanelDocked below); no code-behind needed for this column. -->
            <ColumnDefinition Width="Auto"/>
            <!-- The docked panel's own column - can't use the same Auto-collapses-with-Visibility
                 trick as the splitter column, since it must default to a real, resizable pixel width
                 while docked. ProcessView.xaml.cs's UpdatePanelDockState controls this column's
                 Width/MinWidth/MaxWidth directly instead (mirrors CaptureView.xaml's own identical
                 OptionsPanelColumn). -->
            <ColumnDefinition x:Name="OptionsPanelColumn" Width="0"/>
        </Grid.ColumnDefinitions>

        <!-- md:DrawerHost's right-hand drawer is a full-height overlay, not a permanent Grid column -
             it slides in on top of (not squeezing) the content below, used only while the panel is
             open and *not* pinned (see ProcessViewModel.IsProcessDrawerOpen) - pinning it instead
             docks the exact same ProcessOptionsPanel content into the resizable column on the right
             (below), which shrinks this main content area so the preview/status area is never
             covered. A VS-tool-window-style Pin toggle lives in the panel's own header
             (ProcessOptionsPanel.xaml) for switching between the two - mirrors GSServer's own
             md:DrawerHost usage (e.g. SkyTelescopeV.xaml's VM-bound IsLeftDrawerOpen) with Left
             swapped for Right throughout, per the user's own original request. -->
        <md:DrawerHost Grid.Column="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" BorderThickness="0"
                       IsRightDrawerOpen="{Binding IsProcessDrawerOpen, Mode=TwoWay}"
                       BorderBrush="{StaticResource MaterialDesignDivider}">
            <md:DrawerHost.RightDrawerContent>
                <Border Width="340">
                    <views:ProcessOptionsPanel/>
                </Border>
            </md:DrawerHost.RightDrawerContent>

            <!-- Main content - always full-width since the panel is an overlay drawer rather than a
                 permanent side column. Restructured to match CaptureView's shape: every control
                 (Browse/Process/Cancel/the processed-image picker) lives in one top toolbar row, with
                 the Settings hamburger pinned to the far right (a DockPanel, same reasoning as
                 CaptureView's own top toolbar - see that view's history for why a DockPanel is the
                 right tool once the two sides need different alignment); a scrollable two-column row
                 underneath the buttons holds the file/equipment info (left) alongside a new
                 "Processing Results" panel (right, see ProcessViewModel.DetectedLineText's own doc
                 comment); and the preview fills all remaining space (a Grid row sized "*" - unlike a
                 StackPanel, a Grid can actually stretch a row to fill leftover space) instead of being
                 capped to a fixed 640x640 box. Status narration moved off this view entirely - see
                 StatusBarViewModel.ProcessStatusText - so it's visible from any stage, matching
                 Capture/Mount's own status-bar fields. -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Top bar: Browse/Process/Cancel + the processed-image picker, left-aligned, with
                     the Settings hamburger pushed to the far right. -->
                <DockPanel Grid.Row="0">
                    <ToggleButton DockPanel.Dock="Right" VerticalAlignment="Center" Margin="8,0,0,0"
                                  Style="{StaticResource MaterialDesignHamburgerToggleButtonRightDrawer}"
                                  Command="{x:Static md:DrawerHost.OpenDrawerCommand}"
                                  CommandParameter="{x:Static Dock.Right}"
                                  IsChecked="{Binding IsProcessOptionsPanelExpanded, Mode=TwoWay}"
                                  ToolTip="Show the Process Parameters/Image Enhancement/Image Selection panel"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource ToolbarIconButtonStyle}"
                                Command="{Binding BrowseForSerFileCommand}"
                                ToolTip="Browse for a .ser file to process.">
                            <Image Source="/Assets/Icons/BrowseForFile.png" Width="20" Height="20" Stretch="Uniform"/>
                        </Button>
                        <Button Style="{StaticResource ToolbarIconButtonStyle}"
                                Command="{Binding ProcessCommand}"
                                ToolTip="Run the SHG reconstruction pipeline on the selected file.">
                            <Image Source="/Assets/Icons/ProcessRun.png" Width="20" Height="20" Stretch="Uniform"/>
                        </Button>
                        <Button Style="{StaticResource ToolbarIconButtonStyle}"
                                Command="{Binding CancelProcessingCommand}"
                                Visibility="{Binding IsProcessing, Converter={StaticResource BooleanToVisibilityConverter}}"
                                ToolTip="Cancel the running processing job.">
                            <Image Source="/Assets/Icons/CancelProcessing.png" Width="20" Height="20" Stretch="Uniform"/>
                        </Button>

                        <!-- Opens the pop-out "Crop SER" window (see SerCropWindow.xaml) for old
                             captures recorded without setting a hardware ROI first. -->
                        <Button Style="{StaticResource ToolbarIconButtonStyle}"
                                Command="{Binding OpenSerCropCommand}"
                                ToolTip="Crop a full-frame .ser recording down to a narrower height, centred vertically - for old captures recorded without setting an ROI first.">
                            <Image Source="/Assets/Icons/CropVideo.png" Width="20" Height="20" Stretch="Uniform"/>
                        </Button>

                        <!-- Empty (no items) until an output folder actually has .png files in it - a
                             bare ComboBox collapses to its minimal size, so this stays unobtrusive
                             rather than needing extra visibility plumbing for the "nothing yet" case.
                             Disk-based, not tied to the most recent Process click - see
                             ProcessViewModel's own class doc comment. -->
                        <TextBlock Text="View:" VerticalAlignment="Center" Margin="16,0,8,0" />
                        <ComboBox ItemsSource="{Binding AvailableProcessedImages}"
                                  SelectedItem="{Binding SelectedProcessedImage}"
                                  DisplayMemberPath="Label"
                                  Width="200" VerticalAlignment="Center" />
                    </StackPanel>
                </DockPanel>

                <!-- File/equipment info (left) + the "Processing Results" panel (right) - one
                     scrollable row beneath the toolbar, two columns. MaxHeight bounds it so a long
                     info panel can't crowd out the preview below (a Grid row sized "Auto" would
                     otherwise just grow to fit its content, leaving the image row less than it
                     asked for); typical content is short enough that the scrollbar never actually
                     appears. -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" MaxHeight="220">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding SelectedFilePath}" />
                            <TextBlock Text="{Binding FileInfoText}"
                                       Margin="0,4,0,0"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{Binding EquipmentInfoText}"
                                       Margin="0,4,0,0" />
                            <TextBlock Text="{Binding CaptureDetailsText}"
                                       Margin="0,4,0,0"
                                       Opacity="0.8" />
                            <TextBlock Text="{Binding OutputFolderText}"
                                       Margin="0,4,0,0"
                                       Opacity="0.8" />
                        </StackPanel>

                        <!-- What the last Process run in this session actually detected/produced -
                             astro4j's own two-part "detected line"/"detected geometry" info view (see
                             ShgProcessingResult's own doc comment), plus the overall image-count/
                             output-folder summary. Not persisted anywhere on disk (see
                             ProcessViewModel.DetectedLineText's own doc comment), so a file with
                             pre-existing output from an earlier session shows the "not yet processed
                             this session" placeholders until Process is run again. -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Processing Results" FontWeight="Bold" />
                            <TextBlock Text="{Binding DetectedLineText}"
                                       Margin="0,4,0,0"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{Binding DetectedGeometryText}"
                                       Margin="0,4,0,0"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{Binding IdentifiedLineText}"
                                       Margin="0,4,0,0"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{Binding ResultImagesText}"
                                       Margin="0,4,0,0"
                                       Opacity="0.8"
                                       TextWrapping="Wrap" />
                            <!-- Static - not tied to any per-run result, so it stays visible whether
                                 or not a file has been processed yet this session. -->
                            <TextBlock Margin="0,12,0,0" Opacity="0.8" TextWrapping="Wrap">
                                For more advanced processing and additional output options, consider using
                                <Hyperlink NavigateUri="https://melix.github.io/astro4j/latest/en/jsolex.html" RequestNavigate="OnJSolExLinkRequestNavigate">JSol'Ex</Hyperlink>.
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <!-- Auto-stretched (see ProcessViewModel.UpdateProcessedImagePreview) - the saved PNGs
                     are deliberately unstretched real sensor-scale values, which would look flat/washed
                     here without this. HighQuality scaling since the preview is downsampled then
                     magnified back up, same reasoning as CaptureView's own live-preview Image. Fills
                     all remaining space rather than a fixed MaxWidth/MaxHeight cap, and zooms to fit
                     that space via Stretch="Uniform" - deliberately NOT wrapped in a ScrollViewer this
                     time (an earlier version was, "matching CaptureView's own preview container"): a
                     ScrollViewer measures its content with infinite available size, which defeats
                     Stretch="Uniform" entirely (nothing to shrink-to-fit against) - a well-known WPF
                     gotcha, and exactly why the image was rendering at native resolution needing manual
                     scrolling instead of fitting the view. CaptureView's own zoom (Auto/Fit Width/Fit
                     Height/fixed %) works around the same gotcha with an explicit code-behind-computed
                     Width/Height (see CaptureView.xaml.cs's UpdateImageSize) rather than relying on
                     Stretch alone - not needed here, since Process has no equivalent "pixel-peep a
                     fixed zoom level" use case CaptureView's own doc comment describes. -->
                <Border Grid.Row="4" BorderBrush="Gray" BorderThickness="1">
                    <Image Source="{Binding ProcessedImagePreview}"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                </Border>
            </Grid>
        </md:DrawerHost>

        <!-- Only visible while pinned+open (IsProcessOptionsPanelDocked) - the Auto column above it
             collapses to 0 for free once this is Collapsed, no code-behind needed for this column. -->
        <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Cursor="SizeWE"
                      Background="{StaticResource MaterialDesignDivider}"
                      Visibility="{Binding IsProcessOptionsPanelDocked, Converter={StaticResource BooleanToVisibilityConverter}}"/>

        <!-- The docked panel itself - same ProcessOptionsPanel content as the floating drawer above,
             just resized by OptionsPanelColumn (see ProcessView.xaml.cs's UpdatePanelDockState) instead
             of shown as an overlay. OptionsPanelHost's own SizeChanged reports a user's GridSplitter
             drag back into ProcessViewModel.ProcessOptionsPanelWidth for persistence. -->
        <Border Grid.Column="2" x:Name="OptionsPanelHost" Background="{StaticResource MaterialDesignPaper}">
            <views:ProcessOptionsPanel/>
        </Border>
    </Grid>
</UserControl>
