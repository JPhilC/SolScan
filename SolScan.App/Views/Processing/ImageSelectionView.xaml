<UserControl x:Class="SolScan.App.Views.Processing.ImageSelectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">
    <StackPanel Margin="16" MaxWidth="420" HorizontalAlignment="Left">
        <TextBlock Text="Image Selection" FontWeight="Bold"/>
        <TextBlock Text="Which output images to generate. This is the full set SolScan produces - for anything beyond it (Doppler, redshift, active regions, Debug Options, custom ImageMath scripts, ...) pass the original SER file to JSol'Ex itself."
                   Opacity="0.8" Margin="0,2,0,8" TextWrapping="Wrap"/>
        <CheckBox Content="Raw image" IsChecked="{Binding IsRawSelected}" Margin="0,0,0,4"
                  ToolTip="The disk reconstructed at the pixel shift chosen in Process Parameters, straight off the SER capture - no geometry correction, no contrast enhancement. What the disk actually looked like to the sensor, tilt and all."/>
        <CheckBox Content="Reconstruction (progressive)" IsChecked="{Binding IsReconstructionSelected}" Margin="0,0,0,4"
                  ToolTip="Currently saved as an identical copy of the Raw image. In JSolex this is a separate live-updating preview built up scan-line by scan-line as the capture is read; SolScan has no live progress view yet to make that distinction meaningful."/>
        <CheckBox Content="Continuum" IsChecked="{Binding IsContinuumSelected}" Margin="0,0,0,4"
                  ToolTip="The disk reconstructed at the Continuum pixel shift from Process Parameters - far enough from the studied line's own core to look like an ordinary white-light image rather than showing the line's absorption feature."/>
        <CheckBox Content="Geometry corrected image" IsChecked="{Binding IsGeometryCorrectedSelected}" Margin="0,0,0,4"
                  ToolTip="The Raw reconstruction with tilt/aspect-ratio distortion corrected and the disk warped circular (see the Rotation/Autocrop/Mirror settings in Process Parameters). Real optics rarely deliver a perfectly upright, circular disk straight off the sensor - the slit's alignment and the scan speed both leave their own mark on the raw image's geometry."/>
        <CheckBox Content="Geometry corrected image (processed)" IsChecked="{Binding IsGeometryCorrectedProcessedSelected}" Margin="0,0,0,4"
                  ToolTip="The geometry-corrected image with contrast enhancement applied (see the Image Enhancement tab) - usually the one you actually want to look at, since the other images are all deliberately unenhanced intermediate steps."/>
        <CheckBox Content="Colorized" IsChecked="{Binding IsColorizedSelected}" Margin="0,0,0,4"
                  ToolTip="The processed image tinted to approximate the studied line's real colour (see the Line setting in Process Parameters) - a fixed colour curve for H-alpha, or an approximated visible-spectrum tint for every other named line. Not produced at all when Line is set to 'Other', which has no wavelength to derive a colour from."/>
        <CheckBox Content="Virtual eclipse" IsChecked="{Binding IsVirtualEclipseSelected}"
                  ToolTip="A coronagraph-style view: the solar disk itself is blanked out, then the surrounding region is background-neutralized and stretched, so faint prominences and streamers near the limb - normally buried by the disk's own far greater brightness - become visible the way they would during a real eclipse."/>
    </StackPanel>
</UserControl>
