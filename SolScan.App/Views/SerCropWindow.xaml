<Window x:Class="SolScan.App.Views.SerCropWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="Crop SER File" Width="460" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>
    <!-- Modeless (shown via .Show(), not .ShowDialog(), from ProcessViewModel.OpenSerCrop) so the
         Process view stays usable while a long crop runs in the background - same reasoning as
         HandControlWindow's own doc comment, just for a background file operation instead of a live
         mount jog. Crops a full-frame .ser recording down to a narrower height, centred on the
         frame's own vertical centre, at the full original width - see SerCropViewModel's own doc
         comment for why this exists (old captures recorded without setting a hardware ROI first). -->
    <StackPanel Margin="16">
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" Opacity="0.85"
                   Text="Crops a full-frame .ser recording down to a narrower height, centred on the frame's vertical centre, at the full original width - for old captures recorded without setting an ROI first."/>

        <TextBlock Text="Source file" FontWeight="SemiBold"/>
        <DockPanel Margin="0,4,0,0">
            <Button DockPanel.Dock="Right" Content="Browse…" Width="80" Margin="8,0,0,0"
                    Command="{Binding BrowseForSourceCommand}"
                    ToolTip="Pick the full-frame .ser file to crop."/>
            <TextBox Text="{Binding SourceFilePath, Mode=OneWay}" IsReadOnly="True" VerticalContentAlignment="Center"/>
        </DockPanel>
        <TextBlock Text="{Binding SourceInfoText}" Margin="0,4,0,0" Opacity="0.8"/>

        <TextBlock Text="Height to keep" FontWeight="SemiBold" Margin="0,16,0,0"/>
        <DockPanel Margin="0,4,0,0">
            <TextBlock DockPanel.Dock="Right" Text="%" VerticalAlignment="Center" Margin="6,0,0,0"/>
            <TextBox Text="{Binding HeightPercent, UpdateSourceTrigger=PropertyChanged}"
                     Width="80" HorizontalAlignment="Left"
                     ToolTip="What percentage of the source frame's height to keep, centred vertically - e.g. 20 keeps the middle 20% of rows, discarding the rest equally from top and bottom."/>
        </DockPanel>
        <TextBlock Text="{Binding CroppedHeightPreviewText}" Margin="0,4,0,0" Opacity="0.8" TextWrapping="Wrap"/>

        <TextBlock Text="Output file" FontWeight="SemiBold" Margin="0,16,0,0"/>
        <DockPanel Margin="0,4,0,0">
            <Button DockPanel.Dock="Right" Content="Browse…" Width="80" Margin="8,0,0,0"
                    Command="{Binding BrowseForOutputCommand}"
                    ToolTip="Choose where to save the cropped .ser file. Defaults alongside the source file with a &quot;_cropped&quot; suffix."/>
            <TextBox Text="{Binding OutputFilePath}" VerticalContentAlignment="Center"/>
        </DockPanel>

        <Grid Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding StatusText}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <Button Grid.Column="1" Content="Cancel" Width="80" Margin="8,0,0,0"
                    Command="{Binding CancelCropCommand}"
                    Visibility="{Binding IsCropping, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            <Button Grid.Column="2" Content="Crop" Width="80" Margin="8,0,0,0"
                    Command="{Binding CropCommand}"/>
        </Grid>
    </StackPanel>
</Window>
