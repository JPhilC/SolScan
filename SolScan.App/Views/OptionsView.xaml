<UserControl x:Class="SolScan.App.Views.OptionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:equipment="clr-namespace:SolScan.App.Views.Equipment"
             mc:Ignorable="d">
    <DockPanel>
        <TextBlock DockPanel.Dock="Top"
                   Text="Options"
                   FontSize="20"
                   FontWeight="Bold"
                   Margin="16,16,16,0"/>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="16">
            <Button Content="Save" Width="90" Padding="4" Command="{Binding SaveCommand}"/>
            <TextBlock Text="{Binding StatusText}"
                       VerticalAlignment="Center"
                       Margin="12,0,0,0"
                       Foreground="Gray"/>
        </StackPanel>

        <TabControl Margin="16">
            <TabItem Header="General">
                <StackPanel DataContext="{Binding General}" Margin="16" MaxWidth="640" HorizontalAlignment="Left">
                    <TextBlock Text="Save Location" FontWeight="Bold"/>
                    <TextBlock Text="Where new recordings (.ser files) are saved." Opacity="0.8" Margin="0,2,0,8" TextWrapping="Wrap"/>
                    <DockPanel Margin="0,0,0,4">
                        <Button Content="Browse..." DockPanel.Dock="Right" Width="80" Margin="8,0,0,0"
                                Command="{Binding BrowseForCapturesRootFolderCommand}"/>
                        <TextBox Text="{Binding CapturesRootFolder, UpdateSourceTrigger=PropertyChanged}"/>
                    </DockPanel>
                    <Button Content="Reset to Default" HorizontalAlignment="Left"
                            Command="{Binding ResetCapturesRootFolderToDefaultCommand}"/>

                    <TextBlock Text="Mount Connection" FontWeight="Bold" Margin="0,20,0,0"/>
                    <TextBlock Text="The ASCOM Alpaca (REST) endpoint for the telescope device - see the ASCOM Remote Server."
                               Opacity="0.8" Margin="0,2,0,8" TextWrapping="Wrap"/>
                    <TextBlock Text="Base URL"/>
                    <TextBox Text="{Binding AlpacaBaseUrl, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,4"/>
                    <Button Content="Reset to Default" HorizontalAlignment="Left" Margin="0,0,0,8"
                            Command="{Binding ResetAlpacaBaseUrlToDefaultCommand}"/>
                    <TextBlock Text="Device Number"/>
                    <TextBox Text="{Binding AlpacaDeviceNumber, UpdateSourceTrigger=PropertyChanged}" Width="80" HorizontalAlignment="Left" Margin="0,2,0,0"/>

                    <TextBlock Text="Site Location" FontWeight="Bold" Margin="0,20,0,0"/>
                    <TextBlock Text="Reconciled against the mount's own site settings when Prepare connects to it."
                               Opacity="0.8" Margin="0,2,0,8" TextWrapping="Wrap"/>
                    <TextBlock Text="Latitude (deg)"/>
                    <TextBox Text="{Binding SiteLatitudeDeg, UpdateSourceTrigger=PropertyChanged}" Width="120" HorizontalAlignment="Left" Margin="0,2,0,4"/>
                    <TextBlock Text="Longitude (deg)"/>
                    <TextBox Text="{Binding SiteLongitudeDeg, UpdateSourceTrigger=PropertyChanged}" Width="120" HorizontalAlignment="Left" Margin="0,2,0,4"/>
                    <TextBlock Text="Elevation (m)"/>
                    <TextBox Text="{Binding SiteElevationM, UpdateSourceTrigger=PropertyChanged}" Width="120" HorizontalAlignment="Left" Margin="0,2,0,0"/>
                </StackPanel>
            </TabItem>
            <TabItem Header="SHGs">
                <equipment:SpectrographLibraryView DataContext="{Binding Spectrographs}"/>
            </TabItem>
            <TabItem Header="Telescopes">
                <equipment:TelescopeLibraryView DataContext="{Binding Telescopes}"/>
            </TabItem>
            <TabItem Header="Cameras">
                <equipment:CameraLibraryView DataContext="{Binding Cameras}"/>
            </TabItem>
            <TabItem Header="Setups">
                <equipment:EquipmentSetupLibraryView DataContext="{Binding Setups}"/>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
