<Window x:Class="SolScan.App.Views.HandControlWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="Hand Control" Width="300" Height="250"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Topmost="True">
    <!-- Modeless (shown via .Show(), not .ShowDialog(), from CaptureViewModel.OpenHandControl) so
         the camera preview stays usable while jogging the mount - see SolScan CLAUDE.md's mount-
         control notes. Visually modelled on GSServer's HandControlV/HandController: a compass of
         directional buttons around a central Stop, plus a vertical 1-8 speed slider - but driven
         over ASCOM Alpaca's own MoveAxis/AbortSlew, not a port of GSServer's own driver-level code
         (see HandControlViewModel's doc comment). -->
    <DockPanel Margin="12">
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusText}" Margin="0,10,0,0"
                   Foreground="Gray" TextWrapping="Wrap"/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Compass: N/S/E/W around a central Stop -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="UpButton" Grid.Row="0" Grid.Column="1" Width="56" Height="56"
                        FontSize="20" Content="&#9650;" ToolTip="North (Dec+)"
                        IsEnabled="{Binding IsConnected}"
                        PreviewMouseLeftButtonDown="OnUpDown" PreviewMouseLeftButtonUp="OnDirectionUp"/>

                <Button x:Name="LeftButton" Grid.Row="1" Grid.Column="0" Width="56" Height="56"
                        FontSize="20" Content="&#9664;" ToolTip="West (RA-)"
                        IsEnabled="{Binding IsConnected}"
                        PreviewMouseLeftButtonDown="OnLeftDown" PreviewMouseLeftButtonUp="OnDirectionUp"/>

                <Button x:Name="StopButton" Grid.Row="1" Grid.Column="1" Width="56" Height="56"
                        FontSize="16" Content="&#9632;" ToolTip="Stop"
                        IsEnabled="{Binding IsConnected}" Click="OnStopClick"/>

                <Button x:Name="RightButton" Grid.Row="1" Grid.Column="2" Width="56" Height="56"
                        FontSize="20" Content="&#9654;" ToolTip="East (RA+)"
                        IsEnabled="{Binding IsConnected}"
                        PreviewMouseLeftButtonDown="OnRightDown" PreviewMouseLeftButtonUp="OnDirectionUp"/>

                <Button x:Name="DownButton" Grid.Row="2" Grid.Column="1" Width="56" Height="56"
                        FontSize="20" Content="&#9660;" ToolTip="South (Dec-)"
                        IsEnabled="{Binding IsConnected}"
                        PreviewMouseLeftButtonDown="OnDownDown" PreviewMouseLeftButtonUp="OnDirectionUp"/>
            </Grid>

            <!-- Speed: 1-8, matching GSServer's own HcSpeed range/default - see
                 HandControlViewModel.SpeedLevelFractions for what each level actually resolves to. -->
            <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                <TextBlock Text="Speed" HorizontalAlignment="Center"/>
                <Slider Orientation="Vertical" Height="130" Width="30" Margin="0,4,0,0"
                        Minimum="1" Maximum="8" IsSnapToTickEnabled="True" TickFrequency="1"
                        TickPlacement="Both" Value="{Binding SpeedLevel}"
                        IsEnabled="{Binding IsConnected}"/>
                <TextBlock Text="{Binding SpeedLevel}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                <TextBlock Text="{Binding CurrentRateDegPerSec, StringFormat={}{0:0.0000}°/s}"
                           HorizontalAlignment="Center" FontSize="10" Opacity="0.8"/>
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
