<Window x:Class="SolScan.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:SolScan.App.ViewModels"
        xmlns:views="clr-namespace:SolScan.App.Views"
        mc:Ignorable="d"
        Title="SolScan"
        Width="1200" Height="800"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:PrepareViewModel}">
            <views:PrepareView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CaptureViewModel}">
            <views:CaptureView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProcessViewModel}">
            <views:ProcessView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:OptionsViewModel}">
            <views:OptionsView />
        </DataTemplate>

        <!-- Sidebar's own "selected section" accent colour, same role as RASTA's
             Styles.xaml NavSelectedAccentBrush - kept local here since SolScan doesn't have a
             shared Styles.xaml yet. -->
        <SolidColorBrush x:Key="NavSelectedAccentBrush" Color="#4FC3F7"/>

        <!-- Same flat nav-button template as RASTA's MainWindow.xaml: a template of our own so
             disabled buttons dim (Opacity) instead of the default OS chrome painting a bright
             disabled look that stands out more than the enabled/selected buttons. -->
        <Style x:Key="NavButtonBaseStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Background" Value="#2D2D2D"/>
            <Setter Property="BorderBrush" Value="#2D2D2D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#3A3A3A"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Sidebar: nav buttons run down the left-hand margin, with Options docked to the
             bottom of the sidebar regardless of window height. -->
        <DockPanel Grid.Row="0" Grid.Column="0"
                   Background="#FF050910">

            <!-- Decorative footer, anchored below the Options button at the very bottom of the
                 sidebar - same role as RASTA's MainWindow.xaml ButtonBarFooter.png. -->
            <Image DockPanel.Dock="Bottom"
                   Margin="10"
                   Source="/Assets/ButtonBarFooter.png"/>

            <Button DockPanel.Dock="Bottom"
                    Content="Options"
                    Margin="5"
                    Padding="10"
                    Command="{Binding NavigateOptionsCommand}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource NavButtonBaseStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentSection}" Value="Options">
                                <Setter Property="Background" Value="#444"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Foreground" Value="{StaticResource NavSelectedAccentBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <StackPanel DockPanel.Dock="Top">
                <TextBlock Text="SolScan"
                           Foreground="White"
                           FontSize="28"
                           FontWeight="Bold"
                           Margin="10,10,10,0"/>
                <TextBlock Text="Spectroheliograph Capture &amp; Processing"
                           Foreground="White"
                           FontSize="10"
                           FontWeight="Bold"
                           Margin="10,5,10,15"/>

                <Button Content="Prepare"
                        Margin="5"
                        Padding="10"
                        Command="{Binding NavigatePrepareCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource NavButtonBaseStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentSection}" Value="Prepare">
                                    <Setter Property="Background" Value="#444"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Foreground" Value="{StaticResource NavSelectedAccentBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button Content="Capture"
                        Margin="5"
                        Padding="10"
                        Command="{Binding NavigateCaptureCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource NavButtonBaseStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentSection}" Value="Capture">
                                    <Setter Property="Background" Value="#444"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Foreground" Value="{StaticResource NavSelectedAccentBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button Content="Process"
                        Margin="5"
                        Padding="10"
                        Command="{Binding NavigateProcessCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource NavButtonBaseStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentSection}" Value="Process">
                                    <Setter Property="Background" Value="#444"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Foreground" Value="{StaticResource NavSelectedAccentBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </DockPanel>

        <!-- Main Content -->
        <ContentControl Grid.Row="0" Grid.Column="1"
                        Content="{Binding CurrentViewModel}"
                        Margin="20"/>

        <!-- Status bar: full width, below both the sidebar and content - same role/placement as
             RASTA's own StatusBar.xaml. -->
        <views:StatusBar Grid.Row="1" Grid.ColumnSpan="2"
                         DataContext="{Binding StatusBarViewModel}"/>
    </Grid>
</Window>
