<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes">
    <!-- Merged into individual views' own UserControl.Resources (not App.xaml.Resources) so
         MaterialDesignThemes - used only for md:DrawerHost's hamburger-style side panels - doesn't
         reskin every view in the app, just the ones that actually use it (ProcessView, CaptureView).
         WPF resolves DynamicResource/implicit-style lookups by walking up from the element that needs
         them, so merging at this closer scope still lets DrawerHost and its
         MaterialDesignHamburgerToggleButton/MaterialDesignDivider styles resolve correctly for
         everything inside whichever UserControl merges this dictionary. Same theme/colour dictionaries
         GSServer merges at its own App.xaml for the same library (see
         C:\Source\Repos\JPhilC\GSServer\GS.Server\App.xaml), just Light rather than Dark so these views
         don't look jarringly different from SolScan's other plain-WPF-styled views either side of them
         in the nav - see CLAUDE.md for the full reasoning. -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.Light.xaml" />
        <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.Defaults.xaml" />
        <ResourceDictionary Source="pack://application:,,,/MaterialDesignColors;component/Themes/Recommended/Primary/MaterialDesignColor.Grey.xaml" />
        <ResourceDictionary Source="pack://application:,,,/MaterialDesignColors;component/Themes/Recommended/Accent/MaterialDesignColor.Blue.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- MaterialDesignThemes' own MaterialDesignHamburgerToggleButton animates its hamburger icon into
         a back-arrow that always points left when checked - correct for GSServer's own left-hand
         drawers (which SolScan's own hamburger-drawer usage was modelled on), but backwards for
         SolScan's own right-hand ones (Process/CaptureView, Dock.Right per the user's own request - see
         this file's own doc comment above): with a right-side drawer, "closing" should point right,
         toward the edge the drawer disappears to, not left. Reported directly by the user after trying
         the drawer UI ("the hide button is pointing the wrong way"). A horizontal mirror
         (ScaleTransform ScaleX="-1") is the simplest fix - the hamburger icon itself is symmetric so
         looks identical either way, and only the arrow it morphs into when checked is actually
         reversed. Used by both hamburger ToggleButtons (open and close) on both views that have a
         right-hand drawer, so all four button instances point the same, consistent direction. -->
    <Style x:Key="MaterialDesignHamburgerToggleButtonRightDrawer" TargetType="ToggleButton" BasedOn="{StaticResource MaterialDesignHamburgerToggleButton}">
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        <Setter Property="RenderTransform">
            <Setter.Value>
                <ScaleTransform ScaleX="-1"/>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- MaterialDesignTheme.Light.xaml's own implicit Expander style (merged above) indents the
         header's text a chevron-glyph's width in from the left, while the body content below it
         starts flush at the edge - a mismatch baked into that control template (and into the default
         WPF/Aero one it replaces), not something a Margin/Padding tweak from outside can fix, since
         the indent comes from a column reserved for the expand arrow inside the header's own template.
         Reported directly by the user as looking wrong once several Expanders sat stacked in
         CaptureView.xaml/ProcessView.xaml's drawer panels. This replaces the whole header chrome with
         a flat one that starts at the same left edge as the body: bold text plus a bottom rule (using
         the same MaterialDesignDivider brush the drawer header/DrawerHost border already use) mark it
         as a header instead of the indent, and the expand/collapse chevron moves to the row's right
         edge (▸/▾) rather than displacing the text on the left. Shared here (not duplicated per-view)
         since both views' Expanders have the same problem - same "factor out on second use" precedent
         as this whole file. -->
    <Style x:Key="FlatExpanderHeaderToggleStyle" TargetType="ToggleButton">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Padding" Value="0,6"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}"
                            BorderBrush="{StaticResource MaterialDesignDivider}"
                            BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ContentPresenter Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            <TextBlock x:Name="Chevron" Grid.Column="1" Text="&#9656;" FontSize="11"
                                       Margin="8,0,0,0" VerticalAlignment="Center"
                                       Foreground="{StaticResource MaterialDesignBody}"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chevron" Property="Text" Value="&#9662;"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource MaterialDesignSelection}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FlatExpanderStyle" TargetType="Expander">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Expander">
                    <DockPanel>
                        <ToggleButton DockPanel.Dock="Top"
                                      Style="{StaticResource FlatExpanderHeaderToggleStyle}"
                                      FontWeight="Bold"
                                      IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                      Content="{TemplateBinding Header}"
                                      ContentTemplate="{TemplateBinding HeaderTemplate}"/>
                        <ContentPresenter x:Name="ExpandSite" DockPanel.Dock="Top" Focusable="False"
                                          Margin="0,8,0,0" Visibility="Collapsed"/>
                    </DockPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The VS-tool-window-style Pin toggle in CaptureOptionsPanel.xaml/ProcessOptionsPanel.xaml's
         own headers - switches the panel between md:DrawerHost's default floating overlay and a
         real, resizable docked Grid column (see CaptureViewModel.IsCaptureOptionsPanelPinned/
         IsCaptureDrawerOpen/IsCaptureOptionsPanelDocked's own doc comments for the state this
         drives). A plain ToggleButton wrapping a md:PackIcon - this app's first use of PackIcon,
         confirmed present in the already-referenced MaterialDesignThemes 4.8.0 package (searched its
         DLL directly for "Pin"/"PinOff" rather than assuming). The icon lives directly in the
         ControlTemplate (not a Content Setter - a literal element there would be one shared instance
         reused - and broken - across every ToggleButton that applies this Style) and flips from "Pin"
         to "PinOff" via the same ControlTemplate.Triggers/TargetName idiom FlatExpanderHeaderToggleStyle's
         own chevron above already uses, rather than a new IValueConverter. -->
    <Style x:Key="PanelPinToggleButtonStyle" TargetType="ToggleButton">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="4"/>
        <Setter Property="ToolTip" Value="Pin/unpin this panel - pinned docks it as a resizable column instead of floating over the view."/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <md:PackIcon x:Name="PinIcon" Kind="Pin" Width="18" Height="18"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="PinIcon" Property="Kind" Value="PinOff"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource MaterialDesignSelection}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
