<!-- MSI package for SolScan.App. Files are harvested straight from the dotnet publish output
     (see PublishSolScanApp target in SolScan.Setup.wixproj) via the wildcard <Files> element -
     no heat.exe / manual file list to keep in sync, and that includes whichever vendor camera
     SDK DLLs (ASICamera2.dll/altaircam.dll) happened to be present in SolScan.Infrastructure\
     when this was published - see SolScan.Setup.wixproj's own remarks. This package is
     framework-dependent: it does not carry the .NET runtime or VC++ Redistributable themselves.
     SolScan.Bundle.wixproj chains this MSI together with both of those into a single setup.exe. -->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">

  <Package Name="SolScan"
           Manufacturer="JPhilC"
           Version="$(var.SolScanVersion)"
           UpgradeCode="82A53DD5-AEFB-4E02-9D1F-8E3E16F378D1"
           Scope="perMachine"
           Compressed="yes">

    <MajorUpgrade DowngradeErrorMessage="A newer version of SolScan is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="SolScanIcon.exe" SourceFile="$(var.PublishDir)SolScan.App.exe" />
    <Property Id="ARPPRODUCTICON" Value="SolScanIcon.exe" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="SolScan" FileSource="$(var.PublishDir)">
        <!-- Harvests every file dotnet publish produced (SolScan.App.exe, its dependency DLLs,
             and any vendor camera SDK DLLs SolScan.Infrastructure shipped - see this file's own
             header comment). Falls into the implicit default Feature along with the shortcut
             Components below. -->
        <Files Include="**" />

        <Component Id="ApplicationShortcut">
          <Shortcut Id="StartMenuShortcut"
                     Name="SolScan"
                     Directory="ProgramMenuFolder"
                     WorkingDirectory="INSTALLFOLDER"
                     Icon="SolScanIcon.exe"
                     Target="[INSTALLFOLDER]SolScan.App.exe" />
          <RemoveFolder Id="RemoveProgramMenuFolder" Directory="ProgramMenuFolder" On="uninstall" />
          <RegistryValue Root="HKCU" Key="Software\JPhilC\SolScan" Name="Installed" Type="integer" Value="1" KeyPath="yes" />
        </Component>

        <!-- Desktop shortcut, created unconditionally alongside the Start Menu one above (no
             opt-out checkbox - this package currently has no wizard UI to host one) - installed
             from the off, per design. -->
        <Component Id="DesktopShortcut">
          <Shortcut Id="DesktopShortcutIcon"
                     Name="SolScan"
                     Directory="DesktopFolder"
                     WorkingDirectory="INSTALLFOLDER"
                     Icon="SolScanIcon.exe"
                     Target="[INSTALLFOLDER]SolScan.App.exe" />
          <RemoveFolder Id="RemoveDesktopFolder" Directory="DesktopFolder" On="uninstall" />
          <RegistryValue Root="HKCU" Key="Software\JPhilC\SolScan" Name="DesktopShortcutInstalled" Type="integer" Value="1" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder" />
    <StandardDirectory Id="DesktopFolder" />

  </Package>
</Wix>
